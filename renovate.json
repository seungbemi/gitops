{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "ignorePaths": [
    "kubernetes/persistence/**",
    "kubernetes/kube-system/kube-network/**"
  ],
  "packageRules": [
    {
      "description": "Automerge patch updates only",
      "matchUpdateTypes": ["patch"],
      "automerge": true
    },
    {
      "description": "Require manual review for minor, major, and replacement updates",
      "matchUpdateTypes": ["minor", "major", "replacement"],
      "automerge": false
    }
  ],
  "customManagers": [
    {
      "description": "Container image updates for Helm charts using appVersion",
      "customType": "regex",
      "datasourceTemplate": "docker",
      "fileMatch": ["(^|/)Chart\\.yaml$"],
      "matchStrings": [
        "#\\s*renovate: image=(?<depName>.*?)\\s+appVersion:\\s*[\"']?(?<currentValue>[\\w+\\.\\-]*)"
      ]
    },
    {
      "description": "Container image updates for Helm charts using values.yaml image.tag",
      "customType": "regex",
      "datasourceTemplate": "docker",
      "fileMatch": ["values\\.yaml$"],
      "matchStrings": [
        "#\\s*renovate: image=(?<depName>.*?)\\s+tag:\\s*[\"']?(?<currentValue>[\\w+\\.\\-]*)"
      ]
    }
  ]
}
